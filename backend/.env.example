# ============================================
# EXEMPLO DE CONFIGURAÇÃO - copie para .env
# `cp .env.example .env`
# ============================================
# O modo padrão funciona SEM credenciais externas:
# PIX_PROVIDER=mock + DEMO_MODE=true.

# ----- SERVIDOR -----
NODE_ENV=development
PORT=3000
# 1 quando atrás de proxy reverso confiável (Railway/Render/Nginx)
TRUST_PROXY=false

# MongoDB é obrigatório para persistir pagamentos/assinaturas.
MONGODB_URI=mongodb://127.0.0.1:27017/maisvidaapp

# ----- AUTENTICAÇÃO -----
# Obrigatório quando NODE_ENV != development. Use >= 32 caracteres aleatórios.
JWT_SECRET=change-this-to-a-long-random-secret-before-production
JWT_EXPIRES_IN=30d

# ----- CORS -----
# Allowlist separada por vírgulas. Use domínios explícitos em produção.
# `*` libera qualquer origem (aceitável apenas em desenvolvimento).
CORS_ORIGIN=http://localhost:3000

# ----- MODO DEMONSTRAÇÃO -----
# Habilita POST /api/v1/payments/pix/:id/simulate (somente cobranças mock).
# Mantenha false em produção.
DEMO_MODE=true
# Token aceito em /subscription/activate quando DEMO_MODE=true.
# Em produção, é obrigatório configurar explicitamente se DEMO_MODE=true.
DEMO_ACTIVATION_TOKEN=demo-activation-token

# ----- PIX -----
# mock | mercadopago | asaas | efi
PIX_PROVIDER=mock
PIX_KEY=demo@maisvida.app
PIX_RECEIVER_NAME=MAIS VIDA
PIX_RECEIVER_CITY=SAO PAULO
PIX_EXPIRATION_SECONDS=3600

# Credenciais dos provedores reais (opcionais; não são usadas no mock)
MERCADOPAGO_ACCESS_TOKEN=
ASAAS_API_KEY=
ASAAS_CUSTOMER_ID=
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=

# ----- STRIPE (CARTÃO) -----
# Sem chave, POST /payments/stripe/intent responde 503 STRIPE_NOT_CONFIGURED.
STRIPE_SECRET_KEY=
# Sem secret, webhooks só são aceitos fora de produção (modo de teste).
STRIPE_WEBHOOK_SECRET=

# ----- PLANO -----
PLAN_AMOUNT_CENTS=499
PLAN_DAYS=30

# ----- RATE LIMITS -----
RATE_LIMIT_GENERAL_WINDOW_MS=60000
RATE_LIMIT_GENERAL_MAX=30
RATE_LIMIT_PAYMENT_WINDOW_MS=900000
RATE_LIMIT_PAYMENT_MAX=5
RATE_LIMIT_VALIDATION_WINDOW_MS=60000
RATE_LIMIT_VALIDATION_MAX=10

# ----- OBSERVABILIDADE -----
# debug | info | warn | error | silent
LOG_LEVEL=info
# Swagger UI em /docs e spec em /openapi.yaml
DOCS_ENABLED=true
